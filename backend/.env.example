# Sao chép thành backend/.env khi chạy trên máy. Trên hosting (Vibe Host...) khai báo các biến này
# trong phần "Biến môi trường" của bảng điều khiển; giá trị ở đó luôn được ưu tiên hơn file .env.

# Cổng HTTP. Hosting thường tự đặt PORT; trên máy mặc định là 8080 (Vite proxy /api về đây).
PORT=8080
# Địa chỉ lắng nghe; bỏ trống = mọi địa chỉ. Trên VPS đặt 127.0.0.1 (deploy/portal.service đã đặt) để chỉ Nginx gọi được app.
# HOST=127.0.0.1

# ---- Cơ sở dữ liệu (PostgreSQL / Supabase) ----
# Cách 1 (khuyên dùng trên hosting): một chuỗi kết nối. Lấy ở Supabase > Connect > "Transaction pooler"
# (cổng 6543), thay [YOUR-PASSWORD]. Nếu có thì DATABASE_URL được dùng thay cho các biến DB_* bên dưới.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Cách 2: từng thành phần (giống bản Java cũ).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal_db
DB_USERNAME=postgres
DB_PASSWORD=your_password
# SSL: mặc định bật với máy chủ *.supabase.com/.co, tắt với các máy khác. Đặt true/false để ép.
# DB_SSL=true
DB_POOL_SIZE=10
# Tên hiện trong pg_stat_activity.application_name (vd. portal-local cho máy lập trình).
DB_APP_NAME=portal
# Tự tạo bảng + dữ liệu menu mẫu khi khởi động (bỏ qua nếu DB đã có sẵn từ bản Java). Đặt false để tự chạy
# "npm run db:migrate".
DB_MIGRATE_ON_START=true

# ---- Đăng nhập quản trị ----
# Khoá ký token: ít nhất 32 ký tự ngẫu nhiên (vd. `openssl rand -base64 48`). Thiếu thì phiên đăng nhập
# bị mất mỗi lần khởi động lại.
APP_AUTH_SECRET=
APP_AUTH_TTL_HOURS=8

# ---- Khác ----
# Các origin frontend được gọi API từ domain khác (chỉ cần khi web và API chạy ở 2 domain).
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Số giây giữ danh sách công khai trong bộ nhớ (mọi thao tác ghi của admin xoá cache ngay).
APP_CACHE_TTL=60
# Múi giờ dùng cho "bây giờ" (ngày đăng mặc định, thời điểm tạo/sửa).
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Thư mục bản build frontend; mặc định ../frontend/dist.
# STATIC_DIR=
# Proxy được tin để lấy IP thật của người dùng (giới hạn góp ý / đăng nhập sai tính theo IP). Mặc định tin proxy
# trong mạng nội bộ. Nếu người mới gửi góp ý lần đầu đã bị báo "gửi quá nhiều" (mọi người bị tính chung một IP)
# thì đặt TRUST_PROXY=true (hoặc số tầng proxy, vd. 1).
# TRUST_PROXY=

# ---- Lưu trữ ảnh / tệp đính kèm ----
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
