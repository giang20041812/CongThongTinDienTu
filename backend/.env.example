DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal_db
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Supabase pooler (port 6543, transaction mode) needs 0; a direct PostgreSQL connection may use 5.
DB_PREPARE_THRESHOLD=0

# Name shown in pg_stat_activity.application_name (e.g. portal-local for a developer machine).
DB_APP_NAME=portal

# Admin token signing key: at least 32 random characters (e.g. `openssl rand -base64 48`).
APP_AUTH_SECRET=
APP_AUTH_TTL_HOURS=8

# Comma-separated front-end origins allowed by CORS.
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seconds that public listings are cached in memory (admin writes clear it immediately).
APP_CACHE_TTL=60

# Set to true to print SQL statements while debugging.
SQL_LOG=false

# Liquibase owns the schema (db/changelog). The first start on an old v1 database DROPS the old tables
# (changeset v2-01-reset-legacy) and creates the menu-tree schema with the seeded menu.
LIQUIBASE_ENABLED=true
